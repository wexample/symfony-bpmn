{
  "name": "wexample/symfony-bpmn",
  "description": "BPMN processes run by Symfony: each compiled into a workflow, its lanes guarding who does what, its automatic tasks, timers and messages handled, its paths and rights listed",
  "version": "3.0.3",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyBpmn\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyBpmn\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/php-bpmn": ">=2.0.0",
    "wexample/symfony-helpers": ">=18.0.0",
    "doctrine/orm": "^3.0",
    "doctrine/doctrine-bundle": "^2.13 || ^3.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/expression-language": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0",
    "symfony/security-core": "^7.4 || ^8.0",
    "symfony/workflow": "^7.4 || ^8.0",
    "wexample/symfony-activity": ">=3.0.0",
    "wexample/symfony-api": ">=14.0.0",
    "wexample/symfony-notification": ">=2.1.0",
    "wexample/php-pseudocode": ">=2.2.0",
    "wexample/symfony-pseudocode": ">=4.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "wexample/symfony-testing": ">=2.0.0",
    "symfony/security-bundle": "^7.4 || ^8.0",
    "symfony/translation": "^7.4 || ^8.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}